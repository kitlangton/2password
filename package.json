{
  "name": "2password",
  "version": "0.2.0",
  "description": "1Password for coding agents: find, use, and save secrets without exposing them.",
  "keywords": [
    "1password",
    "agents",
    "cli",
    "op",
    "secrets",
    "skill"
  ],
  "homepage": "https://github.com/kitlangton/2password#readme",
  "bugs": "https://github.com/kitlangton/2password/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitlangton/2password.git"
  },
  "bin": {
    "2password": "bin/2password"
  },
  "files": [
    "bin",
    "src",
    "skills"
  ],
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:keychain": "TWO_PASSWORD_KEYCHAIN_TEST=1 vitest run test/keychain.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "check": "oxfmt --check && oxlint --deny-warnings && tsc --noEmit && vitest run",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "^4.0.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
